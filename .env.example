# Public client configuration (safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side API configuration (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider for /api/assistant (falls back to grounded KB + research synthesizer when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional outbound email provider (falls back to local outbox table when unset)
RESEND_API_KEY=
EMAIL_FROM=noreply@voxrelay.example
# Canonical production website origin used to generate one-time invitation URLs (e.g. https://voxrelay.example)
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-32-byte-random-secret-in-production
