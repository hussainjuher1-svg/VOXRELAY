{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "VOXRELAY",
  "version": "3.0.0",
  "color": {
    "surface": {
      "paper": { "$value": "#F8FAFC", "$type": "color", "$description": "Primary Cool Slate canvas" },
      "card": { "$value": "#FFFFFF", "$type": "color", "$description": "Crisp white card & table surface" },
      "vellum": { "$value": "#F1F5F9", "$type": "color", "$description": "Subtle slate surface & header/table bar" },
      "dark": { "$value": "#0B0F19", "$type": "color", "$description": "Carbon Navy sidebar, boundary band & footer" },
      "darkElevated": { "$value": "#111827", "$type": "color", "$description": "Dark mode card surface" }
    },
    "ink": {
      "primary": { "$value": "#0F172A", "$type": "color", "$description": "Primary Slate 900 ink" },
      "secondary": { "$value": "#475569", "$type": "color", "$description": "Body secondary ink" },
      "muted": { "$value": "#64748B", "$type": "color", "$description": "Captions & tabular metadata" },
      "inverse": { "$value": "#F8FAFC", "$type": "color", "$description": "Text on Carbon Navy surfaces" }
    },
    "line": {
      "hairline": { "$value": "#E2E8F0", "$type": "color", "$description": "1px structural hairline border" },
      "hairlineStrong": { "$value": "#CBD5E1", "$type": "color", "$description": "Input border & card framing" }
    },
    "brand": {
      "primaryCobalt": { "$value": "#2563EB", "$type": "color", "$description": "VOXRELAY enterprise cobalt CTA & active accent" },
      "primaryCobaltHover": { "$value": "#1D4ED8", "$type": "color", "$description": "Cobalt hover state" },
      "primaryCobaltSoft": { "$value": "#EFF6FF", "$type": "color", "$description": "Soft tint for active badges & assistant user turns" }
    },
    "semantic": {
      "ok": { "$value": "#047857", "$type": "color" },
      "warn": { "$value": "#B45309", "$type": "color" },
      "danger": { "$value": "#B91C1C", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "sansEn": "'Inter Tight', -apple-system, BlinkMacSystemFont, sans-serif",
      "sansAr": "'IBM Plex Sans Arabic', -apple-system, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "scale": {
      "hero": { "size": "clamp(1.875rem, 3.6vw, 2.875rem)", "weight": 700, "lineHeight": 1.1, "letterSpacing": "-0.03em" },
      "display": { "size": "clamp(1.625rem, 3vw, 2.375rem)", "weight": 700, "lineHeight": 1.14, "letterSpacing": "-0.025em" },
      "heading": { "size": "1.375rem", "weight": 600, "lineHeight": 1.25, "letterSpacing": "-0.015em" },
      "proseMd": { "size": "1rem", "weight": 400, "lineHeight": 1.62 },
      "ui": { "size": "0.875rem", "weight": 400, "lineHeight": 1.55 },
      "micro": { "size": "0.6875rem", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0.08em", "textTransform": "uppercase" }
    }
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px"
  },
  "motion": {
    "durationFast": "150ms",
    "durationBase": "180ms",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
