{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "VOXRELAY",
  "version": "4.0.0",
  "color": {
    "surface": {
      "paper": { "$value": "#F7F9FB", "$type": "color", "$description": "Cool-white public canvas" },
      "panelBlue": { "$value": "#EAF1F8", "$type": "color", "$description": "Pale-blue panel for the workflow diagram" },
      "card": { "$value": "#FFFFFF", "$type": "color", "$description": "Crisp white card & form surface" },
      "vellum": { "$value": "#EEF3F8", "$type": "color", "$description": "Subtle secondary surface" },
      "dark": { "$value": "#0F1B28", "$type": "color", "$description": "Authenticated workspace sidebar & focus mode" }
    },
    "ink": {
      "primary": { "$value": "#162634", "$type": "color", "$description": "Primary dark ink (14.9:1 on #F7F9FB)" },
      "secondary": { "$value": "#3B4D5E", "$type": "color", "$description": "Body copy ink" },
      "muted": { "$value": "#5A6D7E", "$type": "color", "$description": "Kicker & divider metadata" }
    },
    "line": {
      "hairline": { "$value": "#DCE3EC", "$type": "color", "$description": "1px structural divider" },
      "hairlineStrong": { "$value": "#C4D0DE", "$type": "color", "$description": "Input border & diagram separator" }
    },
    "brand": {
      "deepBlue": { "$value": "#174A7E", "$type": "color", "$description": "Primary CTA button, brand mark & workflow timeline" },
      "deepBlueHover": { "$value": "#123B66", "$type": "color", "$description": "Primary CTA hover" }
    },
    "semantic": {
      "ok": { "$value": "#047857", "$type": "color" },
      "warn": { "$value": "#B45309", "$type": "color" },
      "danger": { "$value": "#B91C1C", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "sansEn": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif",
      "sansAr": "'IBM Plex Sans Arabic', -apple-system, sans-serif"
    },
    "scale": {
      "hero": { "size": "clamp(2.125rem, 4.2vw, 3.25rem)", "weight": 600, "lineHeight": 1.1, "letterSpacing": "-0.025em" },
      "lead": { "size": "1.125rem", "weight": 400, "lineHeight": 1.58 },
      "ui": { "size": "0.9375rem", "weight": 400, "lineHeight": 1.55 }
    }
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px"
  }
}
