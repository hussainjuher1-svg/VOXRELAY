{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": "VOXRELAY",
  "version": "5.0.0",
  "color": {
    "surface": {
      "paper": { "$value": "#FAF7F2", "$type": "color", "$description": "Studio Warm paper canvas" },
      "panelWarm": { "$value": "#F3EDE2", "$type": "color", "$description": "Warm linen hero stage & band surface" },
      "card": { "$value": "#FFFFFF", "$type": "color", "$description": "Floating card & form surface" },
      "dark": { "$value": "#1D1714", "$type": "color", "$description": "Espresso sidebar & marquee ribbon" }
    },
    "ink": {
      "primary": { "$value": "#1F1A17", "$type": "color", "$description": "Primary espresso ink (15.8:1 on #FAF7F2)" },
      "secondary": { "$value": "#4E453E", "$type": "color", "$description": "Body copy ink" },
      "muted": { "$value": "#6D6259", "$type": "color", "$description": "Metadata & divider ink" }
    },
    "line": {
      "hairline": { "$value": "#E4DBCE", "$type": "color", "$description": "1px structural hairline" },
      "hairlineStrong": { "$value": "#CFC2B0", "$type": "color", "$description": "Card border & separator" }
    },
    "brand": {
      "terracotta": { "$value": "#B84A2E", "$type": "color", "$description": "Terracotta CTA, brand mark & underline" },
      "terracottaHover": { "$value": "#9C3B22", "$type": "color", "$description": "Terracotta hover" },
      "gold": { "$value": "#C6922B", "$type": "color", "$description": "Warm studio gold highlight & seal accent" },
      "goldSoft": { "$value": "#F9F0DC", "$type": "color", "$description": "Soft gold wash" }
    },
    "semantic": {
      "ok": { "$value": "#1F6B4A", "$type": "color" },
      "warn": { "$value": "#8F6212", "$type": "color" },
      "danger": { "$value": "#9B2C2C", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "serifEn": "'Instrument Serif', Georgia, serif",
      "serifAr": "'Amiri', 'IBM Plex Sans Arabic', serif",
      "sansEn": "'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif",
      "sansAr": "'IBM Plex Sans Arabic', -apple-system, sans-serif"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "14px"
  }
}
